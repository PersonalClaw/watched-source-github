{
  "name": "watched-source-github",
  "version": "0.1.0",
  "displayName": "GitHub Repo Watcher",
  "description": "Watch GitHub repositories and emit new_release and new_issue events your triggers can bind to. Stdlib-only; a freshly-watched repo plants a high-water mark instead of replaying its history.",
  "icon": "Blocks",
  "license": "MIT",
  "tags": [
    "trigger_source"
  ],
  "cli": {
    "setup": "app_cli:setup",
    "doctor": "app_cli:doctor"
  },
  "loggerRoots": [
    "watched_source_github"
  ],
  "provider": {
    "type": "trigger_source",
    "implementation": "provider:create_provider",
    "settingsSchema": {
      "type": "object",
      "properties": {
        "repos": {
          "type": "string",
          "default": "",
          "x-meta": {
            "label": "Repositories",
            "help": "Comma-separated owner/name list, e.g. \"PersonalClaw/PersonalClaw, octocat/hello-world\"."
          }
        },
        "token": {
          "type": "string",
          "default": "",
          "x-meta": {
            "label": "GitHub Token",
            "help": "A GitHub personal access token. Required for private repos and to raise the unauthenticated rate limit. Leave empty to poll anonymously.",
            "sensitive": true
          }
        },
        "poll_interval_secs": {
          "type": "integer",
          "default": 300,
          "minimum": 60,
          "x-meta": {
            "label": "Poll Interval",
            "help": "Seconds between polls. Floored at 60.",
            "tags": [
              "advanced"
            ]
          }
        },
        "api_base": {
          "type": "string",
          "default": "https://api.github.com",
          "x-meta": {
            "label": "GitHub API Base",
            "help": "Override for GitHub Enterprise. Defaults to the public API.",
            "tags": [
              "advanced"
            ]
          }
        },
        "timeout_secs": {
          "type": "integer",
          "default": 20,
          "x-meta": {
            "label": "Request Timeout",
            "help": "Maximum seconds to wait for a GitHub API response.",
            "tags": [
              "advanced"
            ]
          }
        }
      }
    }
  }
}
